[Unit]
Description=ClipCraft web app
Documentation=https://video-editor.ai-creator.top/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clipcraft
Group=clipcraft
WorkingDirectory=/opt/clipcraft
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=8080
ExecStart=/usr/bin/node scripts/serve.mjs
Restart=always
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/clipcraft
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
